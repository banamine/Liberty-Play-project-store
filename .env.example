# Liberty Play Frontend Environment (Vercel)
# Only 1 variable needed now - the Cloud Run API URL

# Cloud Run backend URL (replace with your deployment)
VITE_CLOUD_RUN_URL=https://liberty-play-api-xxxxx.run.app

# Optional: Archive.org M3U URL (for reference)
VITE_ARCHIVE_M3U_URL=https://archive.org/download/daily-highlights/Alex%2024.m3u

# Optional: RSS feeds
VITE_RSS_FEEDS=https://rss.alexjones.media/,https://rumble.com/feeds/videos.xml?channel=AJNC&sort=new
